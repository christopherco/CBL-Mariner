+  d = tr_f(d, a, b, c, x[10] + 0x8b44f7af, 12)
+  c = tr_f(c, d, a, b, x[11] + 0xffff5bb1, 17)
+  b = tr_f(b, c, d, a, x[12] + 0x895cd7be, 22)
