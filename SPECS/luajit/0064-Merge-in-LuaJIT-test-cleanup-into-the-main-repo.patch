+  assert(rot9r(0,0) == "123456789")
+  assert(rot9r(1,0) == "913245678")
+  assert(rot9r(2,0) == "893124567")
+  assert(rot9r(1,1) == "913245678912345678")
+  assert(rot9r(2,1) == "893124567912345678")
+  assert(rot9r(2,2) == "893124567891324567")
+end
